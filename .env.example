# Archivo .env.example — Plantilla pública de variables de entorno
# Este archivo SÍ se sube al repositorio para que otros desarrolladores
# sepan qué variables necesitan configurar en su entorno local.
#
# Para usarlo: copiar este archivo, renombrarlo a .env y completar con los valores reales.
# El .env con los datos verdaderos está en .gitignore y NUNCA se sube al repositorio.

# Conexión a PostgreSQL
DB_USER=nombre_usuario        # Usuario de la base de datos
DB_HOST=localhost             # Servidor donde corre PostgreSQL (localhost = misma máquina)
DB_NAME=nombre_base_de_datos  # Nombre de la base de datos del proyecto
DB_PASSWORD=contraseña        # Contraseña del usuario de la BD
DB_PORT=5432                  # Puerto por defecto de PostgreSQL